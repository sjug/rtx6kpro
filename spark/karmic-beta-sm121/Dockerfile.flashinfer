ARG UV_IMAGE=ghcr.io/astral-sh/uv@sha256:2f0a1c36ce6323e61bc81d39e692319669c03e385b592d670b6ba36dc884e3aa
FROM ${UV_IMAGE} AS uv
FROM nvcr.io/nvidia/pytorch@sha256:237ecf9ac7373daf91b31bb4f86651ce1ce57b676366ed435aa1aba61dad81d5 AS component
SHELL ["/bin/bash", "-euo", "pipefail", "-c"]
COPY --from=uv /uv /usr/local/bin/uv
ENV TORCH_CUDA_ARCH_LIST=12.1a FLASHINFER_CUDA_ARCH_LIST=12.1a \
    FLASHINFER_LOCAL_VERSION=lil.cu134.sm121.g2206a14e4638 \
    FLASHINFER_SOURCE_COMMIT=2206a14e46387a56c093860a46bbbdd00596b75b \
    FLASHINFER_DISABLE_VERSION_CHECK=1 FLASHINFER_ENABLE_SM90=0 \
    BUILD_NVEP=0 BUILD_NCCL_EP=0 BUILD_NIXL_EP=0 \
    MAX_JOBS=20 FLASHINFER_NVCC_THREADS=1 PYTHONUNBUFFERED=1
COPY verify_flashinfer_component.py /build/verify_flashinfer_component.py
RUN test "$(uname -m)" = aarch64 && uv --version \
    && python /build/verify_flashinfer_component.py --foundation-only
# Sources are fetched only inside this build container, not into a new host
# checkout. Submodule revisions come from the pinned superproject's gitlinks.
RUN git init /build/flashinfer \
    && git -C /build/flashinfer remote add origin https://github.com/local-inference-lab/flashinfer.git \
    && git -C /build/flashinfer fetch --depth=1 origin "$FLASHINFER_SOURCE_COMMIT" \
    && git -C /build/flashinfer checkout --detach FETCH_HEAD \
    && test "$(git -C /build/flashinfer rev-parse HEAD)" = "$FLASHINFER_SOURCE_COMMIT" \
    && test "$(git -C /build/flashinfer rev-parse HEAD^{tree})" = dbbe29fea63e3135dbd980132cacb168473363ef \
    && git -C /build/flashinfer submodule update --init --recursive --jobs 4
WORKDIR /build/flashinfer
RUN python ci/lil_wheels/write_build_metadata.py \
    && uv build --python /usr/bin/python3 --offline --wheel --no-build-isolation --out-dir /artifacts/flashinfer . \
    && uv build --python /usr/bin/python3 --offline --wheel --no-build-isolation --out-dir /artifacts/flashinfer ./flashinfer-jit-cache \
    && git submodule status --recursive > /artifacts/flashinfer/submodules.txt \
    && cd /artifacts/flashinfer && sha256sum *.whl > SHA256SUMS
RUN uv pip install --python /usr/bin/python3 --no-deps --target /opt/flashinfer-check /artifacts/flashinfer/*.whl \
    && cd / && PYTHONPATH=/opt/flashinfer-check python /build/verify_flashinfer_component.py
ARG RECIPE_SHA256
COPY Dockerfile.flashinfer build-flashinfer.sh verify_flashinfer_component.py /artifacts/flashinfer/build-inputs/
RUN cd /artifacts/flashinfer/build-inputs \
    && test "$(sha256sum Dockerfile.flashinfer | cut -d' ' -f1)" = "$RECIPE_SHA256" \
    && sha256sum * > /artifacts/flashinfer/build-inputs.sha256
LABEL local-inference.flashinfer.commit="2206a14e46387a56c093860a46bbbdd00596b75b" \
      local-inference.flashinfer.arch="12.1a" \
      local-inference.flashinfer.recipe.sha256="${RECIPE_SHA256}" \
      local-inference.status="build-component-not-serving-qualified"
