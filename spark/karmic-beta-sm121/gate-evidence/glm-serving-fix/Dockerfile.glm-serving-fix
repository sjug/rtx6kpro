# Launcher-only repair. All engine/native bytes and cache identity stay unchanged.
FROM f30dc6d9a2a6f6fc0ac9ff8cddb04d9f631f4a87b48ca7cac69254802fe83233
ARG GLM_REPAIRED_SHA256
COPY launchers/serve-glm53-flash-karmic-spark.sh /usr/local/bin/
COPY launchers/manifest.json /opt/karmic-build/launcher-manifest.json
ENV GLM_LAUNCHER_SHA256=${GLM_REPAIRED_SHA256}
RUN echo "$GLM_LAUNCHER_SHA256  /usr/local/bin/serve-glm53-flash-karmic-spark.sh" | sha256sum -c - \
    && chmod 755 /usr/local/bin/serve-glm53-flash-karmic-spark.sh
LABEL local-inference.glm.launcher.sha256="${GLM_REPAIRED_SHA256}" \
      local-inference.glm.preflight-repair="filename-and-proxy-path-only" \
      local-inference.glm.parent-image="f30dc6d9a2a6f6fc0ac9ff8cddb04d9f631f4a87b48ca7cac69254802fe83233"
