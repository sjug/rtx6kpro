+
+def local_timestamp() -> str:
+    """Return an unambiguous ISO 8601 timestamp in the client's local zone."""
+    return datetime.now().astimezone().isoformat()
+
+
+def parse_run_metadata(entries: list[str]) -> dict[str, str]:
+    """Parse repeatable KEY=VALUE metadata without allowing silent overrides."""
+    metadata: dict[str, str] = {}
+    for entry in entries:
+        key, separator, value = entry.partition("=")
+        if not separator or not key:
+            raise ValueError(f"invalid metadata {entry!r}; expected KEY=VALUE")
+        if not re.fullmatch(r"[A-Za-z][A-Za-z0-9_.-]*", key):
+            raise ValueError(
+                f"invalid metadata key {key!r}; use letters, digits, dot, underscore, or hyphen"
+            )
+        if key in metadata:
+            raise ValueError(f"duplicate metadata key {key!r}")
+        metadata[key] = value
+    return metadata
+
