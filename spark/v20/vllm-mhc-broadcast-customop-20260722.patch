+
+def _mhc_pre_broadcast_tilelang_fake(
+    residual: torch.Tensor,
+    fn: torch.Tensor,
+    hc_scale: torch.Tensor,
+    hc_base: torch.Tensor,
+    rms_eps: float,
+    hc_pre_eps: float,
+    hc_sinkhorn_eps: float,
+    hc_post_mult_value: float,
+    sinkhorn_repeat: int,
+    n_splits: int = 1,
+    norm_weight: torch.Tensor | None = None,
+    norm_eps: float = 1e-6,
+    fn_broadcast: torch.Tensor | None = None,
+) -> tuple[torch.Tensor, torch.Tensor, torch.Tensor, torch.Tensor]:
+    num_tokens = residual.shape[0]
+    hidden_size = residual.shape[-1]
+    hc_mult = fn.shape[1] // hidden_size
+
+    residual_out = torch.empty(
+        num_tokens, hc_mult, hidden_size, dtype=torch.bfloat16,
+        device=residual.device,
+    )
+    post_mix = torch.empty(
+        num_tokens, hc_mult, 1, dtype=torch.float32, device=residual.device
+    )
+    comb_mix = torch.empty(
+        num_tokens, hc_mult, hc_mult, dtype=torch.float32,
+        device=residual.device,
+    )
+    layer_input = torch.empty(
+        num_tokens, hidden_size, dtype=torch.bfloat16, device=residual.device
+    )
+    return residual_out, post_mix, comb_mix, layer_input
+
+
+_mhc_pre_broadcast_tilelang_impl = mhc_pre_broadcast_tilelang
+
+direct_register_custom_op(
+    op_name="mhc_pre_broadcast_tilelang",
+    op_func=_mhc_pre_broadcast_tilelang_impl,
+    mutates_args=[],
+    fake_impl=_mhc_pre_broadcast_tilelang_fake,
+)
+
+
+def mhc_pre_broadcast_tilelang(*args, **kwargs):
+    """Call broadcast MHC pre through the registered custom op.
+
+    Model code imports this symbol directly. Keeping the public symbol as a
+    thin custom-op wrapper prevents torch.compile from tracing into the
+    DeepGEMM pybind (tf32_hc_prenorm_gemm) and TileLang JIT internals during
+    memory profiling and CUDA graph capture — the same contract as
+    mhc_pre_tilelang above. Without it, the first-layer broadcast path fails
+    engine warmup with dynamo Unsupported on any compiled non-B12X mHC model.
+    """
+    return torch.ops.vllm.mhc_pre_broadcast_tilelang(*args, **kwargs)
