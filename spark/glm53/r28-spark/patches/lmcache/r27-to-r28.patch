+    for rank in range(entry.world_size):
+        lease = service.prepare_store(entry, rank)
+        assert lease is not None
+        fill(mapping, lease, rank)
+        assert service.finish_store(lease.lease_id, True) == (
+            rank == entry.world_size - 1
+        )
