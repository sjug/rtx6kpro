+    high_page: bool,
+    direct_views: bool,
+) -> None:
+    """One run owns the selection fork/join without changing the transaction."""
+    device = require_sm120()
+    first_page = (2**31 // (3008 * 2 * 256) + 1) if high_page else 8
+    caps = _caps(
+        device,
+        max_batch=4,
+        max_raw_state_slots=4,
+        max_q_rows=16,
