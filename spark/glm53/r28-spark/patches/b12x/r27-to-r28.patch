+        torch.testing.assert_close(result, reference.output[:rows], rtol=0, atol=0)
+        assert torch.equal(
+            candidate.selected_positions[:rows], reference.selected_positions[:rows]
+        )
+        assert torch.count_nonzero(candidate.state_errors[:rows]) == 0
