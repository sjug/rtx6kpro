+@dsl_user_op
+def ld_relaxed_sys_global_v4_u32(
+    addr: Int64, *, loc=None, ip=None
+) -> Tuple[Uint32, Uint32, Uint32, Uint32]:
+    """Load one NCCL-style PCIe data-and-epoch line at system scope."""
+
+    result = llvm.inline_asm(
