+    reset(reference)
+    qsa.run(reference, **dynamic)
+    reset(candidate)
+    stream_call()
+    reset(candidate)
+    graph = torch.cuda.CUDAGraph()
+    with torch.cuda.graph(graph):
+        result = stream_call()
+    for _ in range(3):
+        dynamic["query"].normal_()
+        dynamic["index_query"].normal_()
+        dynamic["raw_index_key"].normal_()
+        update_projection()
+        reset(reference)
