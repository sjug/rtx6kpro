+
 set(FLASH_KDA_SUPPORT_ARCHS)
 if(${CMAKE_CUDA_COMPILER_VERSION} VERSION_GREATER_EQUAL 12.0)
   list(APPEND FLASH_KDA_SUPPORT_ARCHS "9.0a")
