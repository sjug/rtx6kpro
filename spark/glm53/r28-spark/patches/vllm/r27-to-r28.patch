+        metadata, pool, pool.stride(0), block, 1, BLOCK=1024
+    )
+
+    expected = torch.full((3, size), 165, dtype=torch.uint8)
+    expected[1].copy_(source[offset : offset + size])
+    torch.testing.assert_close(destination.cpu(), expected)
