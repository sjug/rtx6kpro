ARG BASE_VLLM_SPARK_TREE=d4571e5ba189fcc05534ecae88dee763ffef4e35
ARG BASE_VLLM_PACKAGE_TREE=59c9787400c85d5d4547ef898c5dee41804e7088
ARG BASE_B12X_TREE=c20b6aab67ed791cc226ee91de23f7c45509f436
ARG BASE_B12X_PACKAGE_TREE=00248b09689830e55d8fbce8ee630600b63ef663
ARG VLLM_R27_COMMIT=63a82f8d323e8538cbe6f88ae1812a1c01577a0f
ARG VLLM_R27_TREE=f54cd9ca2b9434727715197d32150b75e82a9ebf
ARG VLLM_R27_PACKAGE_TREE=a336313dfd12c6b692051d1d3291712dda0c2a3d
