COPY patches/vllm/r26-spark-to-r27-spark.patch /tmp/vllm-refresh.patch
COPY patches/vllm/changed-paths.txt /tmp/vllm-changed-paths.expected
COPY patches/b12x/r26-spark-to-r27-spark.patch /tmp/b12x-refresh.patch
COPY patches/b12x/changed-paths.txt /tmp/b12x-changed-paths.expected

# The r26 Spark image already carries the SM121 FlashKDA object, the compiled
# vLLM extensions, and the SM121 LMCache wheel. The r27 lock leaves FlashKDA and
# LMCache unchanged, so this stage refreshes only the vLLM and B12X source trees
# and verifies that every preserved native product is byte-identical afterwards.
RUN set -eux; \
    vllm_root=/opt/jovian-judgement/vllm; \
    b12x_root=/opt/jovian-judgement/b12x; \
    site_packages="$(python -c 'import site; print(site.getsitepackages()[0])')"; \
    triton_source="${vllm_root}/vllm/third_party/triton_kernels"; \
    triton_link="${site_packages}/triton_kernels"; \
    test "$(git -C "${vllm_root}" write-tree)" = "${BASE_VLLM_SPARK_TREE}"; \
    test "$(git -C "${vllm_root}" rev-parse "${BASE_VLLM_SPARK_TREE}:vllm")" = "${BASE_VLLM_PACKAGE_TREE}"; \
    test "$(git -C "${b12x_root}" write-tree)" = "${BASE_B12X_TREE}"; \
    test "$(git -C "${b12x_root}" rev-parse "${BASE_B12X_TREE}:b12x")" = "${BASE_B12X_PACKAGE_TREE}"; \
    test "$(find "${vllm_root}/vllm" -type f -name '*.abi3.so' | wc -l)" = 10; \
    test -f "${vllm_root}/vllm/_flashkda_C.abi3.so"; \
    test -L "${triton_link}"; \
    test "$(readlink -f "${triton_link}")" = "$(readlink -f "${triton_source}")"; \
    test "$(python -c 'import importlib.metadata as m; print(m.version("lmcache"))')" = "${LMCACHE_VERSION}"; \
    test -s "${LMCACHE_CUMEM_INTERPOSER}"; \
    preserved_manifest() { \
      find "${vllm_root}/vllm" -type f \( \
        -name '*.abi3.so' -o -name 'vllm-rs' -o \
        -path '*/vllm_flash_attn/cute/*' -o \
        -path '*/vllm_flash_attn/layers/*' -o \
        -path '*/vllm_flash_attn/ops/*' -o \
        -path '*/third_party/triton_kernels/*' \
      \) ! -path '*/__pycache__/*' ! -name '*.pyc' -print0 \
        | LC_ALL=C sort -z | xargs -0 sha256sum; \
      printf 'triton-link %s\n' "$(readlink -f "${triton_link}")"; \
      sha256sum "${LMCACHE_CUMEM_INTERPOSER}"; \
      find "${site_packages}/lmcache" -type f -name '*.so' -print0 | LC_ALL=C sort -z | xargs -0 sha256sum; \
    }; \
    preserved_manifest > /tmp/build-products.before; \
    test "$(sha256sum "${vllm_root}/vllm/_flashkda_C.abi3.so" | cut -d' ' -f1)" = "${FLASHKDA_SHA256}"; \
    echo "${VLLM_REFRESH_PATCH_SHA256}  /tmp/vllm-refresh.patch" | sha256sum -c -; \
    echo "${VLLM_CHANGED_PATHS_SHA256}  /tmp/vllm-changed-paths.expected" | sha256sum -c -; \
    echo "${B12X_REFRESH_PATCH_SHA256}  /tmp/b12x-refresh.patch" | sha256sum -c -; \
    echo "${B12X_CHANGED_PATHS_SHA256}  /tmp/b12x-changed-paths.expected" | sha256sum -c -; \
    git -C "${vllm_root}" apply /tmp/vllm-refresh.patch; \
    git -C "${vllm_root}" add -A; \
    test "$(git -C "${vllm_root}" write-tree)" = "${VLLM_SPARK_TREE}"; \
    test "$(git -C "${vllm_root}" rev-parse "${VLLM_SPARK_TREE}:vllm")" = "${VLLM_PACKAGE_TREE}"; \
    git -C "${vllm_root}" diff --name-only --no-renames "${BASE_VLLM_SPARK_TREE}" "${VLLM_SPARK_TREE}" | LC_ALL=C sort > /tmp/vllm-changed-paths.actual; \
    cmp /tmp/vllm-changed-paths.expected /tmp/vllm-changed-paths.actual; \
    while IFS= read -r path; do \
      case "${path}" in *.py|*.sh|*.cmake|*.md) ;; *) echo "R27 vLLM refresh rejects ${path}" >&2; exit 1 ;; esac; \
    done < /tmp/vllm-changed-paths.actual; \
    grep -Fq 'tl.cast(block, tl.int64)' "${vllm_root}/vllm/v1/worker/gpu/boundary_checkpoint.py"; \
    grep -Fq 'tl.cast(slot, tl.int64)' "${vllm_root}/vllm/v1/worker/gpu/boundary_checkpoint.py"; \
    test -f "${vllm_root}/tests/v1/worker/test_boundary_checkpoint_restore_scalars.py"; \
    grep -Fq 'recurrent_instruction_boundary' "${vllm_root}/vllm/renderers/online_renderer.py"; \
    grep -Fq '_SUPPORTED_NVFP4_CAPABILITIES = frozenset(((12, 0), (12, 1)))' "${vllm_root}/vllm/models/glm5next/nvidia/mtp_draft_head.py"; \
    grep -Fq '12.0;12.1")' "${vllm_root}/CMakeLists.txt"; \
    git -C "${b12x_root}" apply /tmp/b12x-refresh.patch; \
    git -C "${b12x_root}" add -A; \
    test "$(git -C "${b12x_root}" write-tree)" = "${B12X_TREE}"; \
    test "$(git -C "${b12x_root}" rev-parse "${B12X_TREE}:b12x")" = "${B12X_PACKAGE_TREE}"; \
    git -C "${b12x_root}" diff --name-only --no-renames "${BASE_B12X_TREE}" "${B12X_TREE}" | LC_ALL=C sort > /tmp/b12x-changed-paths.actual; \
    cmp /tmp/b12x-changed-paths.expected /tmp/b12x-changed-paths.actual; \
    while IFS= read -r path; do \
      case "${path}" in *.py|*.c|*.md|*.json|*.json.gz|*.txt|*.toml|*.sh) ;; *) echo "R27 B12X refresh rejects ${path}" >&2; exit 1 ;; esac; \
    done < /tmp/b12x-changed-paths.actual; \
    ! grep -Fq 'scale_physical_base[:, -1].fill_(127)' "${b12x_root}/b12x/gemm/blockscaled/_linear.py"; \
    grep -Fq 'Persistent CTAs also reuse sC across multiple stores.' "${b12x_root}/b12x/_lib/dense_gemm.py"; \
    test -f "${b12x_root}/b12x/loader/_direct.c"; \
    test -f "${b12x_root}/b12x/policy/_profiles/data/nvidia.gb10.48sm.json.gz"; \
    cd "${vllm_root}"; \
    VLLM_TARGET_DEVICE=empty VLLM_REQUIRE_RUST_FRONTEND=1 VLLM_VERSION_OVERRIDE="${VLLM_PACKAGE_VERSION}" \
      python -m pip install --no-build-isolation --no-deps --force-reinstall .; \
    test "$(python -c 'import importlib.metadata as m; print(m.version("vllm"))')" = "${VLLM_PACKAGE_VERSION}"; \
    test "$(python -c 'import importlib.metadata as m; print(m.version("b12x"))')" = 1.3.0; \
    git -C "${vllm_root}" diff --quiet; \
    git -C "${b12x_root}" diff --quiet; \
    preserved_manifest > /tmp/build-products.after; \
    cmp /tmp/build-products.before /tmp/build-products.after; \
    test "$(readlink -f "${triton_link}")" = "$(readlink -f "${triton_source}")"; \
    test "$(sha256sum "${vllm_root}/vllm/_flashkda_C.abi3.so" | cut -d' ' -f1)" = "${FLASHKDA_SHA256}"; \
    ldd "${vllm_root}/vllm/_flashkda_C.abi3.so" | tee /tmp/flashkda.ldd; \
    ! grep -Fq 'not found' /tmp/flashkda.ldd; \
    ldd "${LMCACHE_CUMEM_INTERPOSER}" | tee /tmp/lmcache.ldd; \
    ! grep -Fq 'not found' /tmp/lmcache.ldd; \
    cd /; \
    python -c 'import lmcache.cuda_ops, lmcache.lmcache_fs, lmcache.lmcache_native, lmcache.lmcache_redis'; \
    proxy_source=/opt/jovian-judgement/b12x/b12x/comm/roce/_roce_proxy.c; \
    proxy_digest="$(sha256sum "${proxy_source}" | cut -c1-16)"; \
    proxy_so="${B12X_ROCE_CACHE_DIR}/roce_proxy-${proxy_digest}.so"; \
    test "$(python -c 'from b12x.comm import roce; print(roce.API_VERSION)')" = "${B12X_ROCE_API_VERSION}"; \
    python -c 'from b12x.comm.roce._proxy import load; load()'; \
    test -s "${proxy_so}"; \
    test "$(python -c 'from b12x.comm.roce._proxy import load; print(load().roce_abi_version())')" = "${B12X_ROCE_PROXY_ABI}"; \
    ldd "${proxy_so}" | tee /tmp/roce-proxy.ldd; \
    ! grep -Fq 'not found' /tmp/roce-proxy.ldd; \
    CC=/bin/false python -c 'from b12x.comm.roce._proxy import load; load()'; \
    rm -rf /tmp/*.ldd /tmp/build-products.* /tmp/*-changed-paths.* /tmp/*-refresh.patch

COPY --chmod=0755 launchers/serve-glm53-flash-jj-r27-spark.sh /usr/local/bin/serve-glm53-flash-jj-r27-spark.sh
COPY --chmod=0755 launchers/serve-qwen38-flash-next-jj-r27-spark.sh /usr/local/bin/serve-qwen38-flash-next-jj-r27-spark.sh
