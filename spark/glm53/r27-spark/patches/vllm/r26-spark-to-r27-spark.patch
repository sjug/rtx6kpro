+def prefill_compute_share_type(value: str) -> PrefillComputeShare:
+    """Parse a fixed prefill share or automatic compute sharing."""
+    if value == "auto":
+        return "auto"
+    try:
+        share = float(value)
+    except ValueError as exc:
+        raise argparse.ArgumentTypeError(
