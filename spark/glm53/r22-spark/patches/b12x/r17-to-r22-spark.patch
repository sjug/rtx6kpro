+                element_type=Float32,
+                layout=cute.make_layout((2 * _CHUNK,), stride=(1,)),
+                byte_alignment=16,
+            )
+            s_beta = allocator.allocate_tensor(
+                element_type=Float32,
+                layout=cute.make_layout((_CHUNK,), stride=(1,)),
+                byte_alignment=16,
