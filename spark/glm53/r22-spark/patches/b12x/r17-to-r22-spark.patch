+            sum_row = column >> Int32(3)
+            sum_part = column & Int32(7)
+            q_sq = Float32(0.0)
+            k_sq = Float32(0.0)
+            for item in cutlass.range_constexpr(_HEAD_DIM // 8):
+                element = sum_row * Int32(_HEAD_DIM) + Int32(item * 8) + sum_part
+                q_value = Float32(s_raw[element])
