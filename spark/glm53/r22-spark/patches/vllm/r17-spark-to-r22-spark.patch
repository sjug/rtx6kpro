+  "${mode}" "${dspark_depth_mode}" \
+  "${backend}" "${allreduce_mode}" \
+  "${tp_size}" "${dcp_size}" "${max_num_seqs}" \
+  "${graph_cap}" "${load_format}" "${INSTANTTENSOR_BACKEND}" \
+  "${native_l2_enabled}" \
+  "${PYTORCH_CUDA_ALLOC_CONF:-<unset>}" "${model}" >&2
+printf 'Command:' >&2
+printf ' %q' "${command[@]}" >&2
