ARG FLASHKDA_REPO=https://github.com/vllm-project/FlashKDA.git
ARG FLASHKDA_COMMIT=3b225bf26bb8e218928a1fe14751cb48cf31d11b
ARG FLASHKDA_TREE=e8cf226562e56d0817462de76a614d32a83409ef
ARG FLASHKDA_CUTLASS_COMMIT=5c149f52a436782210263fb2f19b354443a61c6a

SHELL ["/bin/bash", "-o", "pipefail", "-c"]

ENV TORCH_CUDA_ARCH_LIST=12.1a \
    CUTE_DSL_ARCH=sm_121a \
    MAX_JOBS=8 \
    NVCC_THREADS=2

COPY patches/vllm/r17-spark-to-r22-spark.patch /tmp/vllm-refresh.patch

# R22 changes FlashKDA's source pin. Rebuild that one extension against the
# inherited Torch/CUDA ABI and leave every other native vLLM object untouched.
RUN set -eux; \
    vllm_root=/opt/jovian-judgement/vllm; \
    test "$(git -C "${vllm_root}" write-tree)" = "${BASE_VLLM_SPARK_TREE}"; \
    echo "${VLLM_REFRESH_PATCH_SHA256}  /tmp/vllm-refresh.patch" | sha256sum -c -; \
    git -C "${vllm_root}" apply /tmp/vllm-refresh.patch; \
    git -C "${vllm_root}" add -A; \
    test "$(git -C "${vllm_root}" write-tree)" = "${VLLM_SPARK_TREE}"; \
    git clone --filter=blob:none --no-checkout "${FLASHKDA_REPO}" /tmp/flashkda-src; \
    git -C /tmp/flashkda-src fetch --depth=1 origin "${FLASHKDA_COMMIT}"; \
    git -C /tmp/flashkda-src checkout --detach "${FLASHKDA_COMMIT}"; \
    test "$(git -C /tmp/flashkda-src write-tree)" = "${FLASHKDA_TREE}"; \
    git -C /tmp/flashkda-src submodule update --init --depth=1 cutlass; \
    test "$(git -C /tmp/flashkda-src/cutlass rev-parse HEAD)" = "${FLASHKDA_CUTLASS_COMMIT}"; \
    FLASH_KDA_SRC_DIR=/tmp/flashkda-src cmake -S "${vllm_root}" -B /tmp/flashkda-build -G Ninja \
      -DCMAKE_BUILD_TYPE=RelWithDebInfo \
      -DCMAKE_INSTALL_PREFIX=/tmp/flashkda-install \
      -DVLLM_TARGET_DEVICE=cuda \
      -DVLLM_PYTHON_EXECUTABLE=/opt/venv/bin/python \
      -DVLLM_PYTHON_PATH="${PYTHONPATH:-}" \
      -DCMAKE_CUDA_COMPILER=/usr/local/cuda/bin/nvcc \
      -DNVCC_THREADS=2; \
    cmake --build /tmp/flashkda-build --target _flashkda_C -j 8; \
    cmake --install /tmp/flashkda-build --component _flashkda_C; \
    test "$(find /tmp/flashkda-install -type f -name '_flashkda_C*.so' | wc -l)" = 1; \
    ldd /tmp/flashkda-install/vllm/_flashkda_C*.so | tee /tmp/flashkda.ldd; \
    ! grep -Fq 'not found' /tmp/flashkda.ldd

FROM ${BASE_IMAGE} AS lmcache-builder

ARG LMCACHE_REPO=https://github.com/local-inference-lab/LMCache.git
ARG LMCACHE_ACQUISITION_COMMIT=b13fa35eb2a1e35ba2cfd4277a0b93bf1cfd322b
ARG LMCACHE_TREE=683ab2c165a9aa0e2d1a1ab757af4a8b193688c5
ARG LMCACHE_PACKAGE_TREE=976a97f22c0497f34db089dc5f02a713dd0b5888
ARG LMCACHE_VERSION=0.5.5.dev0+glm53cache.aefe3ab7

SHELL ["/bin/bash", "-o", "pipefail", "-c"]

ENV TORCH_CUDA_ARCH_LIST=12.1a \
    CMAKE_CUDA_ARCHITECTURES=121a \
    BUILD_WITH_CUDA=1 \
    ENABLE_CXX11_ABI=1 \
    LMCACHE_CUDA_MAJOR=13 \
    MAX_JOBS=8 \
    NVCC_THREADS=2

# The published R22 LMCache commit is not advertised by the public repository.
# b13fa35 is a public acquisition commit with the exact published repository
# and package trees; both are checked before compilation.
RUN set -eux; \
    git clone --filter=blob:none --no-checkout "${LMCACHE_REPO}" /tmp/lmcache-src; \
    git -C /tmp/lmcache-src fetch --depth=1 origin "${LMCACHE_ACQUISITION_COMMIT}"; \
    git -C /tmp/lmcache-src checkout --detach "${LMCACHE_ACQUISITION_COMMIT}"; \
    test "$(git -C /tmp/lmcache-src write-tree)" = "${LMCACHE_TREE}"; \
    test "$(git -C /tmp/lmcache-src rev-parse "${LMCACHE_TREE}:lmcache")" = "${LMCACHE_PACKAGE_TREE}"; \
    make -C /tmp/lmcache-src/csrc/cumem_ipc_interposer CUDA_HOME=/usr/local/cuda; \
    test -s /tmp/lmcache-src/csrc/cumem_ipc_interposer/liblmcache_cumem_shareable.so; \
    cd /tmp/lmcache-src; \
    SETUPTOOLS_SCM_PRETEND_VERSION="${LMCACHE_VERSION}" \
      python -m pip wheel --no-build-isolation --no-deps -w /tmp/lmcache-wheel .; \
    test "$(find /tmp/lmcache-wheel -maxdepth 1 -type f -name 'lmcache-*.whl' | wc -l)" = 1; \
    python -m pip install --no-deps --force-reinstall /tmp/lmcache-wheel/lmcache-*.whl; \
    cd /; \
    test "$(python -c 'import importlib.metadata as m; print(m.version("lmcache"))')" = "${LMCACHE_VERSION}"; \
    python -c 'import lmcache.cuda_ops, lmcache.lmcache_fs, lmcache.lmcache_native, lmcache.lmcache_redis'

