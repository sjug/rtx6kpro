+            _native_linear(linear)
+        self.rotary_emb = build_deepseek_v4_rope(
+            hf,
+            head_dim=512,
+            rope_head_dim=64,
+            max_position_embeddings=hf.max_position_embeddings,
+            compress_ratio=self.compress_ratio,
+        )
+        self.swa_cache_layer = _Cache(
+            vllm_config,
+            f"{prefix}.swa_cache",
+            kind="swa",
+            window=self.window_size,
