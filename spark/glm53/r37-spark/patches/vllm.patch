+"""PLE cache-group ownership and fixed-address mixed graph inputs."""
+
+from types import SimpleNamespace
+
+import pytest
+import torch
+
+from tests.v1.attention.utils import (
+    BatchSpec,
+    create_common_attn_metadata,
+    create_vllm_config,
+)
+from vllm.config import SpeculativeConfig
