+            block_size=config.cache_config.block_size,
+            num_kv_heads=1,
+            head_size=512,
+            state_content_bytes=288,
+            dtype=torch.uint8,
+            tokens_per_state=self.compress_ratio,
+            cache_dtype_str="b12x_dsv41",
+            alignment=None,
