+    for rows in (8, 16, 8, 16):
+        inputs.normal_()
+        run(rows)
+        expected = outputs[:rows].clone()
+        outputs.fill_(float("nan"))
+        graphs[rows].replay()
+        torch.testing.assert_close(outputs[:rows], expected, rtol=0, atol=0)
