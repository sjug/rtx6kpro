+"""SM120 V4.1 attention entry point; no foreign-provider dispatch."""
+
+from vllm.models.deepseek_v4_1.attention import DeepseekV4Attention
+from vllm.models.deepseek_v4_1.sparse_mla import DeepseekV41B12xBackend
+
+
