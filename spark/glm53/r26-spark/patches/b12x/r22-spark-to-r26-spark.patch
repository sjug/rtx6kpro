+        warp_mma_gemm(
+            tiled_mma_pv,
+            accumulator_output,
+            register_probability,
+            register_value,
+            copy_source_probability,
+            copy_source_value,
+            copy_probability,
+            copy_value,
+        )
+        cute.arch.sync_threads()
