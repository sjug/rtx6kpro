+                Path("b12x/moe/_shared/kernels/w4a16/kernel.py"),
+                Path("b12x/moe/_shared/kernels/w4a16/prepare.py"),
+                Path("b12x/moe/_shared/kernels/micro.py"),
+                Path("b12x/_lib/intrinsics.py"),
