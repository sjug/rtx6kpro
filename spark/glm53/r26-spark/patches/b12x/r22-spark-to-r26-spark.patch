+        workspace.fill_(255)
+        output.fill_(float("nan"))
+        graph.replay()
+        if promoted:
+            assert_close(output, expected)
+        else:
+            torch.testing.assert_close(output, expected, atol=0, rtol=0)
+    finally:
+        unfreeze_kernel_resolution()
+        _policy.resolve_precision.cache_clear()
