+            try:
+                with torch.cuda.graph(graph):
+                    fused_moe.run(binding=binding)
+            finally:
+                b12x.unfreeze_kernel_resolution()
+            arm["graph"] = graph
+            arm["binding"] = binding
+            arm["output"] = out
+            for _ in range(args.warmup):
+                graph.replay()
+            torch.cuda.synchronize()
