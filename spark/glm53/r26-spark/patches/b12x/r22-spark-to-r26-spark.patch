+            assert_close(output, source.float() @ decoded.T)
+        assert pointers == (source.data_ptr(), output.data_ptr(), workspace.data_ptr())
+        torch.testing.assert_close(storage.view(torch.uint8), saved, atol=0, rtol=0)
