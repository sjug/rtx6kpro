+@cute.jit
+def _sort_out_by_index(
+    tx: Int32,
+    s_out: cute.Tensor,
+    n: cutlass.Constexpr[int],
+    log2n: cutlass.Constexpr[int],
+    per_thread: cutlass.Constexpr[int],
+):
+    """Bitonic sort of the selected virtual indices into ascending order.
+
+    Admission positions come from atomic counters, so without this the output
+    order (not the set) would still depend on arrival order. ``n`` is the
+    power-of-two top-k capacity; every slot holds a valid virtual index here.
+    All 1024 threads must call this.
+    """
+    for b_kk in cutlass.range_constexpr(log2n):
+        b_k = 2 << b_kk
+        for b_jj in cutlass.range_constexpr(b_kk + 1):
+            b_j = b_k >> (b_jj + 1)
+            for b_e in cutlass.range_constexpr(per_thread):
+                b_i = tx + Int32(b_e * _THREADS_PER_CTA)
+                if b_i < Int32(n):
+                    b_l = Int32(Uint32(b_i) ^ Uint32(b_j))
+                    if b_l > b_i:
+                        b_a = Int32(s_out[b_i])
+                        b_b = Int32(s_out[b_l])
+                        b_swap = Int32(0)
+                        if (Uint32(b_i) & Uint32(b_k)) == Uint32(0):
+                            if b_a > b_b:
+                                b_swap = Int32(1)
+                        else:
+                            if b_a < b_b:
+                                b_swap = Int32(1)
+                        if b_swap != Int32(0):
+                            s_out[b_i] = b_b
+                            s_out[b_l] = b_a
+            cute.arch.sync_threads()
+
