+@cute.jit
+def _admit_smallest_index_ties(
+    tx: Int32,
+    rem: Int32,
+    tie_key: Uint32,
+    tie_mask: Uint32,
+    from_buffer: cutlass.Constexpr[bool],
+    cand: cute.Tensor,
+    num_cand: Int32,
+    s_hist0: cute.Tensor,
+    s_hist1: cute.Tensor,
+    s_out: cute.Tensor,
+    h0: Int32,
+    ctr: Int32,
+    sel: Int32,
+    pfx: Int32,
+    remp: Int32,
+    topk_static: Int32,
+    carry_indices,
+    row_start: Int32,
+    output_index_offset: Int32,
+    carry_base: Int32,
+    chunk_len: Int32,
+    flat: cutlass.Constexpr[bool],
+    flat_values,
+    input_tensor,
+    carry_values,
+    row_base: Int32,
+    block_q: cutlass.Constexpr[int],
+    block_k: cutlass.Constexpr[int],
+    is_tiled: cutlass.Constexpr[bool],
+    is_first: cutlass.Constexpr[bool],
+):
+    """Admit the ``rem`` tied candidates with the smallest logical indices.
+
+    A candidate is tied when ``(key32 & tie_mask) == tie_key``. The buffered
+    arm passes the round-3 low byte (its buffer already shares the upper 24 key
+    bits); the overflow fallback passes the full pivot key and re-scans the row.
+    Selection is a four-round ascending MSD radix over the 32-bit logical index
+    using deterministic integer histograms, so the admitted set never depends
+    on thread arrival order. Positions in ``s_out`` are still assigned with an
+    atomic counter; the caller canonicalizes order afterwards. Scalars: sel =
+    chosen bucket, pfx = locked index prefix, remp = remaining slots.
+    All 1024 threads must call this.
+    """
+    if tx == Int32(0):
+        _smem_st(pfx, Int32(0), Int32(0))
+        _smem_st(remp, Int32(0), rem)
+    cute.arch.sync_threads()
+    for q_round in cutlass.range_constexpr(4):
+        q_shift = Uint32(24 - q_round * 8)
+        q_prefix = Uint32(_smem_ld(pfx, Int32(0)))
+        q_remaining = Int32(_smem_ld(remp, Int32(0)))
+        if tx < Int32(256):
+            s_hist0[tx] = Int32(0)
+        cute.arch.sync_threads()
+        q_i = Int32(tx)
+        while q_i < num_cand:
+            q_vidx = q_i
+            if cutlass.const_expr(from_buffer):
+                q_vidx = Int32(cand[q_i])
+            q_key = _convert_to_uint32(
+                _fallback_load_value(
+                    flat,
+                    q_vidx,
+                    flat_values,
+                    input_tensor,
+                    carry_values,
+                    row_base,
+                    row_start,
+                    carry_base,
+                    chunk_len,
+                    block_q,
+                    block_k,
+                    is_tiled,
+                    is_first,
+                )
+            )
+            if (q_key & tie_mask) == tie_key:
+                q_gkey = Uint32(
+                    _logical_index_virtual(
+                        carry_indices,
+                        row_start,
+                        output_index_offset,
+                        carry_base,
+                        chunk_len,
+                        q_vidx,
+                        is_first,
+                    )
+                )
+                if cutlass.const_expr(q_round == 0):
+                    _smem_red_add(
+                        h0, Int32((q_gkey >> q_shift) & Uint32(0xFF)), Int32(1)
+                    )
+                else:
+                    q_mask = Uint32(0xFFFFFFFF) << Uint32(32 - q_round * 8)
+                    if (q_gkey & q_mask) == q_prefix:
+                        _smem_red_add(
+                            h0, Int32((q_gkey >> q_shift) & Uint32(0xFF)), Int32(1)
+                        )
+            q_i = q_i + Int32(_THREADS_PER_CTA)
+        cute.arch.sync_threads()
+        # Ascending inclusive prefix: s_hist0[b] = count of tied candidates
+        # whose current index byte is <= b (eight stages, result in s_hist0).
+        for q_stage in cutlass.range_constexpr(8):
+            q_j = Int32(1 << q_stage)
+            if tx < Int32(256):
+                if (q_stage & 1) == 0:
+                    q_v = Int32(s_hist0[tx])
+                    if tx >= q_j:
+                        q_v = q_v + Int32(s_hist0[tx - q_j])
+                    s_hist1[tx] = q_v
+                else:
+                    q_v = Int32(s_hist1[tx])
+                    if tx >= q_j:
+                        q_v = q_v + Int32(s_hist1[tx - q_j])
+                    s_hist0[tx] = q_v
+            cute.arch.sync_threads()
+        if tx < Int32(256):
+            q_inc = Int32(s_hist0[tx])
+            q_below = Int32(0)
+            if tx > Int32(0):
+                q_below = Int32(s_hist0[tx - Int32(1)])
+            if (q_inc >= q_remaining) & (q_below < q_remaining):
+                _smem_st(sel, Int32(0), Int32(tx))
+                _smem_st(remp, Int32(0), q_remaining - q_below)
+        cute.arch.sync_threads()
+        q_bucket = Uint32(_smem_ld(sel, Int32(0)))
+        # Admit every tied candidate in a lower bucket now; the final round also
+        # admits the (unique-index) candidate in the chosen bucket itself.
+        q_i = Int32(tx)
+        while q_i < num_cand:
+            q_vidx = q_i
+            if cutlass.const_expr(from_buffer):
+                q_vidx = Int32(cand[q_i])
+            q_key = _convert_to_uint32(
+                _fallback_load_value(
+                    flat,
+                    q_vidx,
+                    flat_values,
+                    input_tensor,
+                    carry_values,
+                    row_base,
+                    row_start,
+                    carry_base,
+                    chunk_len,
+                    block_q,
+                    block_k,
+                    is_tiled,
+                    is_first,
+                )
+            )
+            if (q_key & tie_mask) == tie_key:
+                q_gkey = Uint32(
+                    _logical_index_virtual(
+                        carry_indices,
+                        row_start,
+                        output_index_offset,
+                        carry_base,
+                        chunk_len,
+                        q_vidx,
+                        is_first,
+                    )
+                )
+                q_match = Int32(1)
+                if cutlass.const_expr(q_round != 0):
+                    q_mask = Uint32(0xFFFFFFFF) << Uint32(32 - q_round * 8)
+                    if (q_gkey & q_mask) != q_prefix:
+                        q_match = Int32(0)
+                if q_match != Int32(0):
+                    q_byte = (q_gkey >> q_shift) & Uint32(0xFF)
+                    q_admit = Int32(0)
+                    if q_byte < q_bucket:
+                        q_admit = Int32(1)
+                    if cutlass.const_expr(q_round == 3):
+                        if q_byte == q_bucket:
+                            q_admit = Int32(1)
+                    if q_admit != Int32(0):
+                        q_pos = _smem_xadd(ctr, Int32(0), Int32(1))
+                        if q_pos < topk_static:
+                            s_out[q_pos] = q_vidx
+            q_i = q_i + Int32(_THREADS_PER_CTA)
+        cute.arch.sync_threads()
+        if tx == Int32(0):
+            _smem_st(pfx, Int32(0), Int32(q_prefix | (q_bucket << q_shift)))
+        cute.arch.sync_threads()
+
