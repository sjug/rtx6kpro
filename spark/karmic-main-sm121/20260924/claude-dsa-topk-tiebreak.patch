+@cute.jit
+def _logical_index_virtual(
+    carry_indices,
+    row_start: Int32,
+    output_index_offset: Int32,
+    carry_base: Int32,
+    chunk_len: Int32,
+    vidx: Int32,
+    is_first: cutlass.Constexpr[bool],
+) -> Int32:
+    """Logical (request-relative, never page-mapped) K index of a virtual candidate.
+
+    This is the deterministic tie key: among candidates whose fp32 keys are
+    equal at the selection boundary, the lowest logical index wins. Carried
+    entries pass their already-global logical index through, so a fold chunk
+    ranks ties exactly like a single global selection would.
+    """
+    gidx = Int32(0)
+    if cutlass.const_expr(is_first):
+        gidx = row_start + vidx + output_index_offset
+    else:
+        if vidx < chunk_len:
+            gidx = row_start + vidx + output_index_offset
+        else:
+            gidx = Int32(carry_indices[carry_base + (vidx - chunk_len)])
+    return gidx
+
