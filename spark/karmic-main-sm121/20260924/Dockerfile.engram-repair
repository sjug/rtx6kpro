FROM e7b273407022ae74726d6c7b7465aa567b2c5a0594d5e0b46002a742a11f5146
ARG ENGRAM_LOCK
ARG ENGRAM_CACHE
ARG ENGRAM_VLLM_TREE
ARG ENGRAM_B12X_TREE
COPY . /opt/ds41-engram-repair/
RUN /opt/venv/bin/python /opt/ds41-engram-repair/install_engram_repair.py
ENV XDG_CACHE_HOME=/cache/jit/${ENGRAM_CACHE} \
    VLLM_CACHE_ROOT=/cache/jit/${ENGRAM_CACHE}/vllm \
    TORCHINDUCTOR_CACHE_DIR=/cache/jit/${ENGRAM_CACHE}/inductor \
    TRITON_CACHE_DIR=/cache/jit/${ENGRAM_CACHE}/triton \
    B12X_COMPILE_CACHE_DIR=/cache/jit/${ENGRAM_CACHE}/b12x \
    B12X_CUTE_COMPILE_CACHE_DIR=/cache/jit/${ENGRAM_CACHE}/b12x/cute \
    SPARKINFER_COMPILE_CACHE_DIR=/cache/jit/${ENGRAM_CACHE}/b12x/compile \
    CUTE_DSL_CACHE_DIR=/cache/jit/${ENGRAM_CACHE}/cute-dsl
LABEL local-inference.ds41.diagnostic.kind="engram-prequeued-native-io-fix" \
    local-inference.ds41.diagnostic.lock.sha256="${ENGRAM_LOCK}" \
    local-inference.cache.fingerprint="${ENGRAM_CACHE}" \
    vllm.source-tree="${ENGRAM_VLLM_TREE}" \
    b12x.source-tree="${ENGRAM_B12X_TREE}" \
    local-inference.status="candidate-not-qualified" \
    org.opencontainers.image.title="DS4.1 deterministic candidate with progress-safe disk Engram"
